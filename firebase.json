{
  "hosting": {
    "site": "gtrades-axis",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/academy-admin",
        "destination": "/academy.html"
      },
      {
        "source": "/admin-video-upload",
        "destination": "/admin-video-upload.html"
      },
      {
        "source": "/admin-videos",
        "destination": "/admin-videos.html"
      },
      {
        "source": "/admin-payments",
        "destination": "/admin-payments.html"
      },
      {
        "source": "/admin-trades",
        "destination": "/admin-trades.html"
      },
      {
        "source": "/admin-members",
        "destination": "/admin-members.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}

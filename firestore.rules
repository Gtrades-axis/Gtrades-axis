rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isPremium() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.membership == "premium";
    }

    function hasPremiumAccess() {
      return isAdmin() || isPremium();
    }

    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read: if isOwner(userId) || isAdmin();

      allow update:
        if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.membership == resource.data.membership
        );

      allow delete: if isAdmin();

      // CANONICAL JOURNAL STORAGE
      // Student journal writes here. Admin reads every student's trades.
      // Public homepage can read ONLY trades explicitly published by an admin.
      match /trades/{tradeId} {
        allow read:
          if isOwner(userId)
          || isAdmin()
          || resource.data.public == true;

        allow create:
          if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.public == false;

        allow update:
          if isAdmin()
          || (
            isOwner(userId)
            && request.resource.data.userId == userId
            && request.resource.data.public == resource.data.public
          );

        allow delete:
          if isOwner(userId) || isAdmin();
      }

      // Current journal account storage. Existing account documents are preserved.
      match /accounts/{accountId} {
        allow read, create, update, delete:
          if isOwner(userId) || isAdmin();

        match /trades/{tradeId} {
          allow read, create, update, delete:
            if isOwner(userId) || isAdmin();
        }
      }

      // Existing/new journalAccounts path retained for compatibility.
      match /journalAccounts/{accountId} {
        allow read, create, update, delete:
          if isOwner(userId) || isAdmin();

        match /trades/{tradeId} {
          allow read, create, update, delete:
            if isOwner(userId) || isAdmin();
        }
      }

      // Legacy tradingAccounts path retained.
      match /tradingAccounts/{accountId} {
        allow read, create, update, delete:
          if isOwner(userId) || isAdmin();

        match /trades/{tradeId} {
          allow read, create, update, delete:
            if isOwner(userId) || isAdmin();
        }
      }
    }

    // Legacy/top-level trade feed retained. Nothing is migrated automatically.
    match /trades/{tradeId} {
      allow read: if resource.data.public == true || isAdmin();
      allow create:
        if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete:
        if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /academy_modules/{moduleId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /resources/{resourceId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /videos/{videoId} {
      allow read: if hasPremiumAccess();
      allow write: if isAdmin();
    }

    match /premium_resources/{resourceId} {
      allow read: if hasPremiumAccess();
      allow write: if isAdmin();
    }

    match /premium_videos/{videoId} {
      allow read: if hasPremiumAccess();
      allow write: if isAdmin();
    }

    match /premium_academy/{moduleId} {
      allow read: if hasPremiumAccess();
      allow write: if isAdmin();
    }

    match /user_progress/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow create:
        if signedIn()
        && (
          (request.resource.data.userId != null && request.resource.data.userId == request.auth.uid)
          || (request.resource.data.uid != null && request.resource.data.uid == request.auth.uid)
        );

      allow read:
        if isAdmin()
        || (
          signedIn()
          && (
            (resource.data.userId != null && resource.data.userId == request.auth.uid)
            || (resource.data.uid != null && resource.data.uid == request.auth.uid)
          )
        );

      allow update, delete: if isAdmin();
    }

    match /paymentLogs/{logId} {
      allow create, read: if isAdmin();
      allow update, delete: if false;
    }

    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
